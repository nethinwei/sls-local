{
  "uid": "sls-local-quickstart",
  "title": "sls-local 快速上手",
  "schemaVersion": 41,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service_name",
        "type": "query",
        "datasource": {
          "type": "nethinwei-sls-datasource",
          "uid": "sls"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "query": {
          "query": "* | select service_name from log group by service_name order by service_name limit 100",
          "format": "table"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "日志量（按级别）",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "nethinwei-sls-datasource",
        "uid": "sls"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "nethinwei-sls-datasource",
            "uid": "sls"
          },
          "query": "* | select $__timeGroup(__time__) as time, level, count(*) as count from log where service_name in (${service_name:sqlstring}) group by time, level order by time limit 10000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 耗时（ms）",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "nethinwei-sls-datasource",
        "uid": "sls"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "nethinwei-sls-datasource",
            "uid": "sls"
          },
          "query": "* | select $__timeGroup(__time__) as time, service_name, approx_percentile(cost_ms, 0.95) as p95 from log where service_name in (${service_name:sqlstring}) group by time, service_name order by time limit 10000"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "错误与告警日志",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "nethinwei-sls-datasource",
        "uid": "sls"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "nethinwei-sls-datasource",
            "uid": "sls"
          },
          "query": "(level: ERROR or level: WARN) and service_name: $service_name",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
